<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <com.example.countdown.SoftFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="0dp"
                app:softMode="well"
                app:softRadius="14dp">

                <EditText
                    android:id="@+id/edit_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/hint_title"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textColor="@color/soft_text"
                    android:textColorHint="@color/soft_muted"
                    android:textSize="16sp" />
            </com.example.countdown.SoftFrame>

            <TextView
                android:id="@+id/title_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/title_required"
                android:textColor="@color/soft_error"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.example.countdown.SoftFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="0dp"
                app:softMode="well"
                app:softRadius="14dp">

                <EditText
                    android:id="@+id/edit_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/hint_category"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textColor="@color/soft_text"
                    android:textColorHint="@color/soft_muted"
                    android:textSize="16sp" />
            </com.example.countdown.SoftFrame>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_target_date"
                android:textColor="@color/soft_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.countdown.SoftButton
                android:id="@+id/btn_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:softRadius="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_days"
                android:textColor="@color/soft_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.countdown.SoftFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                app:softDepth="4dp"
                app:softMode="well"
                app:softRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.example.countdown.SoftButton
                        android:id="@+id/btn_everyday"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_everyday"
                        app:softDepth="3dp"
                        app:softRadius="12dp" />

                    <com.example.countdown.SoftButton
                        android:id="@+id/btn_weekdays"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_weekdays"
                        app:softDepth="3dp"
                        app:softRadius="12dp" />

                </LinearLayout>
            </com.example.countdown.SoftFrame>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.example.countdown.SoftButton
                    android:id="@+id/day_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/day_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/day_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/day_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/day_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/day_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/day_7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:minHeight="48dp"
                android:text="@string/include_today"
                android:textColor="@color/soft_text" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_yearly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:minHeight="48dp"
                android:text="@string/repeat_yearly_switch"
                android:textColor="@color/soft_text" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:minHeight="48dp"
                android:text="@string/pin_event"
                android:textColor="@color/soft_text" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_notify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:minHeight="48dp"
                android:text="@string/notify_event"
                android:textColor="@color/soft_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_skip_holidays"
                android:textColor="@color/soft_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_no_holidays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:text="@string/no_holidays_hint"
                android:textColor="@color/soft_muted" />

            <com.example.countdown.SoftFrame
                android:id="@+id/holiday_well"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                app:softMode="well"
                app:softRadius="14dp">

                <LinearLayout
                    android:id="@+id/holiday_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.example.countdown.SoftFrame>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_color"
                android:textColor="@color/soft_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.example.countdown.SoftButton
                    android:id="@+id/color_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/color_dot"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/color_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/color_dot"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/color_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/color_dot"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/color_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/color_dot"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/color_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/color_dot"
                    app:labelPad="0dp"
                    app:softDepth="2dp"
                    app:softRadius="10dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_widget_bg"
                android:textColor="@color/soft_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.countdown.SoftFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                app:softMode="well"
                app:softRadius="14dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/img_bg_preview"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="@drawable/image_mask"
                        android:clipToOutline="true"
                        android:contentDescription="@string/bg_preview_desc"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_bg_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text="@string/no_bg_hint"
                        android:textColor="@color/soft_muted" />
                </FrameLayout>
            </com.example.countdown.SoftFrame>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.example.countdown.SoftButton
                    android:id="@+id/btn_pick_image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pick_image"
                    app:softRadius="14dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/btn_remove_image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/remove_image"
                    android:visibility="gone"
                    app:softRadius="14dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_scrim_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/soft_muted"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seek_scrim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="80"
                android:minHeight="48dp" />

            <com.example.countdown.SoftFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                app:softDepth="4dp"
                app:softMode="well"
                app:softRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.example.countdown.SoftButton
                        android:id="@+id/btn_text_light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/text_light"
                        app:softDepth="3dp"
                        app:softRadius="12dp" />

                    <com.example.countdown.SoftButton
                        android:id="@+id/btn_text_dark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/text_dark"
                        app:softDepth="3dp"
                        app:softRadius="12dp" />

                </LinearLayout>
            </com.example.countdown.SoftFrame>

            <com.example.countdown.SoftFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:softRadius="18dp">

                <TextView
                    android:id="@+id/tv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textColor="@color/soft_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.example.countdown.SoftFrame>

            <com.example.countdown.SoftButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                app:softRadius="14dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
