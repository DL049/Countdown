<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <com.example.countdown.SoftFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:softRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notify_title"
                    android:textColor="@color/soft_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_notify_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_notify_switch"
                    android:textColor="@color/soft_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_notify_hint"
                    android:textColor="@color/soft_muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_notify_time"
                    android:textColor="@color/soft_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.example.countdown.SoftButton
                    android:id="@+id/btn_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notify_time"
                    app:softRadius="14dp" />

            </LinearLayout>
        </com.example.countdown.SoftFrame>

        <com.example.countdown.SoftFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:softRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_holiday_title"
                    android:textColor="@color/soft_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/import_ics_hint"
                    android:textColor="@color/soft_muted"
                    android:textSize="13sp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/btn_import_ics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_ics"
                    app:softRadius="14dp" />

            </LinearLayout>
        </com.example.countdown.SoftFrame>

        <com.example.countdown.SoftFrame
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:softRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup_title"
                    android:textColor="@color/soft_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/backup_hint"
                    android:textColor="@color/soft_muted"
                    android:textSize="13sp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/btn_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/export_backup"
                    app:softRadius="14dp" />

                <com.example.countdown.SoftButton
                    android:id="@+id/btn_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_backup"
                    app:softRadius="14dp" />

            </LinearLayout>
        </com.example.countdown.SoftFrame>

    </LinearLayout>
</ScrollView>
