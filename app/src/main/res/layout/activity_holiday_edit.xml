<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <com.example.countdown.SoftFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="0dp"
                app:softMode="well"
                app:softRadius="14dp">

                <EditText
                    android:id="@+id/edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/hint_holiday_name"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textColor="@color/soft_text"
                    android:textColorHint="@color/soft_muted"
                    android:textSize="16sp" />
            </com.example.countdown.SoftFrame>

            <TextView
                android:id="@+id/name_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="@string/title_required"
                android:textColor="@color/soft_error"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_start"
                android:textColor="@color/soft_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.countdown.SoftButton
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:softRadius="14dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/single_day"
                android:textColor="@color/soft_text" />

            <TextView
                android:id="@+id/label_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/label_end"
                android:textColor="@color/soft_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.countdown.SoftButton
                android:id="@+id/btn_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:softRadius="14dp" />

            <com.example.countdown.SoftButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/save"
                app:softRadius="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
